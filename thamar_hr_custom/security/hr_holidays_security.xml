<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Clinical Manager Group -->
    <record id="group_hr_holidays_clinical_manager" model="res.groups">
        <field name="name">Clinical Manager</field>
        <!-- <field name="category_id" ref="base.module_category_human_resources"/> -->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Record Rule: Clinical Manager can read leaves requiring clinical approval in their companies -->
    <record id="hr_leave_clinical_manager_rule" model="ir.rule">
        <field name="name">Clinical Manager: Own Leaves</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[('requires_clinical_approval', '=', True), ('clinical_manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('thamar_hr_custom.group_hr_holidays_clinical_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Department Supervisor Group -->
    <record id="group_hr_holidays_department_supervisor" model="res.groups">
        <field name="name">Department Supervisor</field>
        <!-- <field name="category_id" ref="base.module_category_human_resources"/> -->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Record Rule: Department Supervisor can read/write leaves in their department -->
    <record id="hr_leave_department_supervisor_rule" model="ir.rule">
        <field name="name">Department Supervisor: Department Leaves</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[('department_supervisor_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('thamar_hr_custom.group_hr_holidays_department_supervisor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Department Manager Group -->
    <record id="group_hr_holidays_department_manager" model="res.groups">
        <field name="name">Department Manager</field>
        <!-- <field name="category_id" ref="base.module_category_human_resources"/> -->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Record Rule: Department Manager can read/write leaves in their department -->
    <record id="hr_leave_department_manager_rule" model="ir.rule">
        <field name="name">Department Manager: Department Leaves</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[('department_manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('thamar_hr_custom.group_hr_holidays_department_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
