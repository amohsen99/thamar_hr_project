<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════
         Blend Ratio - Form View
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_cartella_blend_ratio_form" model="ir.ui.view">
        <field name="name">cartella.blend.ratio.form</field>
        <field name="model">cartella.blend.ratio</field>
        <field name="arch" type="xml">
            <form string="نسبة الخلط">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="material_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Blend Ratio - List View
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_cartella_blend_ratio_list" model="ir.ui.view">
        <field name="name">cartella.blend.ratio.list</field>
        <field name="model">cartella.blend.ratio</field>
        <field name="arch" type="xml">
            <list string="نسب الخلط" editable="bottom">
                <field name="material_id"/>
                <field name="name" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Blend Ratio - Search View
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_cartella_blend_ratio_search" model="ir.ui.view">
        <field name="name">cartella.blend.ratio.search</field>
        <field name="model">cartella.blend.ratio</field>
        <field name="arch" type="xml">
            <search string="بحث في نسب الخلط">
                <field name="name" string="الاسم"/>
                <field name="material_id" string="الخامة"/>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Blend Ratio - Window Action
    ═══════════════════════════════════════════════════════════════ -->
    <record id="action_cartella_blend_ratio" model="ir.actions.act_window">
        <field name="name">نسب الخلط</field>
        <field name="res_model">cartella.blend.ratio</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cartella_blend_ratio_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                أضف أول نسبة خلط
            </p>
        </field>
    </record>
</odoo>
