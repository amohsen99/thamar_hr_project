<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════
         Raw Material - Form View
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_cartella_raw_material_form" model="ir.ui.view">
        <field name="name">cartella.raw.material.form</field>
        <field name="model">cartella.raw.material</field>
        <field name="arch" type="xml">
            <form string="الخامة">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="اسم الخامة"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="category_code" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Raw Material - List View
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_cartella_raw_material_list" model="ir.ui.view">
        <field name="name">cartella.raw.material.list</field>
        <field name="model">cartella.raw.material</field>
        <field name="arch" type="xml">
            <list string="الخامات">
                <field name="name"/>
                <field name="category_id"/>
                <field name="category_code"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Raw Material - Search View
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_cartella_raw_material_search" model="ir.ui.view">
        <field name="name">cartella.raw.material.search</field>
        <field name="model">cartella.raw.material</field>
        <field name="arch" type="xml">
            <search string="بحث في الخامات">
                <field name="name" string="الاسم"/>
                <field name="category_id" string="الفئة"/>
                <field name="category_code" string="كود الفئة"/>
                <separator/>
                <filter
                    name="group_by_category"
                    string="تجميع بـ: الفئة"
                    context="{'group_by': 'category_id'}"/>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Raw Material - Window Action
    ═══════════════════════════════════════════════════════════════ -->
    <record id="action_cartella_raw_material" model="ir.actions.act_window">
        <field name="name">الخامات</field>
        <field name="res_model">cartella.raw.material</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cartella_raw_material_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                أضف أول خامة
            </p>
        </field>
    </record>
</odoo>
