<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Public mobile web page for cartella cards.
        Standalone HTML — does NOT inherit web.layout to avoid
        Bootstrap/Odoo CSS conflicts with our dark glassmorphism design.
    -->
    <template id="cartella_card_public_page" name="Cartella Card - Public View">
        <html lang="ar" dir="rtl">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0"/>
                <meta name="robots" content="noindex, nofollow"/>
                <meta name="theme-color" content="#0f0c29"/>
                <title>
                    كارتيلة - <t t-esc="card.sequence_number"/>
                </title>
                <style>
/* ── Reset ─────────────────────────────────────────────────── */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html, body {
    height: 100%;
}

body {
    font-family: 'Segoe UI', 'Cairo', 'Tahoma', 'Arial', sans-serif;
    background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
    background-attachment: fixed;
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    direction: rtl;
    padding: 24px 16px 40px;
    color: #fff;
    -webkit-font-smoothing: antialiased;
}

/* ── Page container ─────────────────────────────────────────── */
.crt-page {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    gap: 14px;
}

/* ── Header ─────────────────────────────────────────────────── */
.crt-header {
    text-align: center;
    padding: 4px 0 8px;
}

.crt-brand {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    margin-bottom: 10px;
}

.crt-seq {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.18);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 50px;
    padding: 8px 22px;
    font-size: 16px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 1.5px;
}

/* ── Main glass card ────────────────────────────────────────── */
.crt-card {
    background: rgba(255,255,255,0.07);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 22px;
    overflow: hidden;
    box-shadow:
        0 20px 60px rgba(0,0,0,0.5),
        inset 0 1px 0 rgba(255,255,255,0.1);
}

/* product title bar */
.crt-title-bar {
    background: linear-gradient(90deg, #6c63ff, #48c6ef);
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.crt-title-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(255,255,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
}

.crt-title-label {
    font-size: 11px;
    color: rgba(255,255,255,0.75);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.crt-title-value {
    font-size: 18px;
    font-weight: 700;
    color: #fff;
    margin-top: 2px;
    line-height: 1.3;
}

/* ── Specs grid ─────────────────────────────────────────────── */
.crt-specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
}

.crt-spec {
    padding: 15px 18px;
    border-top: 1px solid rgba(255,255,255,0.06);
    border-left: 1px solid rgba(255,255,255,0.06);
    transition: background 0.2s;
}

.crt-spec:nth-child(odd) {
    border-left: none;
}

.crt-spec:hover {
    background: rgba(255,255,255,0.05);
}

.crt-spec-label {
    font-size: 10px;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 5px;
}

.crt-spec-value {
    font-size: 16px;
    font-weight: 600;
    color: #fff;
    line-height: 1.3;
}

.crt-spec-value.accent {
    color: #a29bfe;
}

.crt-spec-value.mono {
    font-family: 'Courier New', monospace;
    font-size: 14px;
    letter-spacing: 1px;
    color: #74b9ff;
}

.crt-spec-value small {
    font-size: 10px;
    color: rgba(255,255,255,0.35);
    font-weight: 400;
    margin-right: 2px;
}

.crt-spec.wide {
    grid-column: 1 / -1;
    border-left: none;
}

/* ── QR section ─────────────────────────────────────────────── */
.crt-qr-section {
    background: rgba(255,255,255,0.07);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 22px;
    padding: 24px 20px;
    text-align: center;
    box-shadow:
        0 10px 40px rgba(0,0,0,0.3),
        inset 0 1px 0 rgba(255,255,255,0.1);
}

.crt-qr-title {
    font-size: 10px;
    color: rgba(255,255,255,0.35);
    text-transform: uppercase;
    letter-spacing: 2.5px;
    margin-bottom: 18px;
}

.crt-qr-img {
    width: 170px;
    height: 170px;
    border-radius: 16px;
    background: #fff;
    padding: 10px;
    display: block;
    margin: 0 auto 16px;
    box-shadow:
        0 4px 30px rgba(108,99,255,0.5),
        0 0 0 1px rgba(108,99,255,0.3);
}

.crt-barcode-str {
    display: inline-block;
    font-family: 'Courier New', monospace;
    font-size: 13px;
    letter-spacing: 2px;
    color: #a29bfe;
    background: rgba(108,99,255,0.12);
    border: 1px solid rgba(108,99,255,0.3);
    border-radius: 8px;
    padding: 8px 16px;
}

/* ── Action button ──────────────────────────────────────────── */
.crt-btn {
    display: block;
    width: 100%;
    padding: 16px;
    background: linear-gradient(90deg, #6c63ff, #48c6ef);
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    border: none;
    border-radius: 16px;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    box-shadow:
        0 8px 30px rgba(108,99,255,0.5),
        inset 0 1px 0 rgba(255,255,255,0.2);
    letter-spacing: 0.5px;
    transition: opacity 0.2s, transform 0.15s;
}

.crt-btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(108,99,255,0.6);
}

.crt-btn:active {
    transform: translateY(0);
}

/* ── Footer ─────────────────────────────────────────────────── */
.crt-footer {
    text-align: center;
    color: rgba(255,255,255,0.2);
    font-size: 11px;
    padding-bottom: 4px;
}

/* ── Responsive ─────────────────────────────────────────────── */
@media (max-width: 360px) {
    .crt-specs { grid-template-columns: 1fr; }
    .crt-spec { border-left: none; }
    .crt-spec.wide { grid-column: 1; }
}
                </style>
            </head>
            <body>
                <div class="crt-page">

                    <!-- Header -->
                    <div class="crt-header">
                        <div class="crt-brand">Al-Omar Group &#160;·&#160; الكارتيلات</div>
                        <div class="crt-seq">
                            🏷 &#160;
                            <t t-esc="card.sequence_number or 'N/A'"/>
                        </div>
                    </div>

                    <!-- Main card -->
                    <div class="crt-card">

                        <!-- Product title bar -->
                        <div class="crt-title-bar">
                            <div class="crt-title-icon">🧵</div>
                            <div>
                                <div class="crt-title-label">اسم المنتج التام</div>
                                <div class="crt-title-value">
                                    <t t-esc="card.finished_product_id.name or '—'"/>
                                </div>
                            </div>
                        </div>

                        <!-- Specs -->
                        <div class="crt-specs">

                            <!-- Raw detail (full-width if present) -->
                            <t t-if="card.raw_material_detail">
                                <div class="crt-spec wide">
                                    <div class="crt-spec-label">اسم المنتج الخام بالتفصيل</div>
                                    <div class="crt-spec-value" style="font-size:14px; color:rgba(255,255,255,0.7);">
                                        <t t-esc="card.raw_material_detail"/>
                                    </div>
                                </div>
                            </t>

                            <!-- Finished width -->
                            <div class="crt-spec">
                                <div class="crt-spec-label">عرض التام</div>
                                <div class="crt-spec-value accent">
                                    <t t-esc="'%.2f' % card.finished_width"/>
                                    <small>سم</small>
                                </div>
                            </div>

                            <!-- Finished weight -->
                            <div class="crt-spec">
                                <div class="crt-spec-label">وزن التام</div>
                                <div class="crt-spec-value accent">
                                    <t t-esc="'%.3f' % card.finished_weight"/>
                                    <small>جم/م²</small>
                                </div>
                            </div>

                            <!-- Raw width -->
                            <div class="crt-spec">
                                <div class="crt-spec-label">عرض الخام</div>
                                <div class="crt-spec-value">
                                    <t t-esc="'%.2f' % card.raw_width"/>
                                </div>
                            </div>

                            <!-- Raw weight -->
                            <div class="crt-spec">
                                <div class="crt-spec-label">وزن الخام</div>
                                <div class="crt-spec-value">
                                    <t t-esc="'%.3f' % card.raw_weight"/>
                                </div>
                            </div>

                            <!-- Yarn count -->
                            <t t-if="card.yarn_count">
                                <div class="crt-spec">
                                    <div class="crt-spec-label">نمرة الخيط</div>
                                    <div class="crt-spec-value">
                                        <t t-esc="card.yarn_count"/>
                                    </div>
                                </div>
                            </t>

                            <!-- Blend ratio -->
                            <t t-if="card.blend_ratio_id">
                                <div class="crt-spec">
                                    <div class="crt-spec-label">نسبة الخلط</div>
                                    <div class="crt-spec-value" style="font-size:13px; color:rgba(255,255,255,0.65);">
                                        <t t-esc="card.blend_ratio_id.name"/>
                                    </div>
                                </div>
                            </t>

                            <!-- Reference -->
                            <t t-if="card.reference">
                                <div class="crt-spec wide">
                                    <div class="crt-spec-label">الكود / المرجع</div>
                                    <div class="crt-spec-value mono">
                                        <t t-esc="card.reference"/>
                                    </div>
                                </div>
                            </t>

                        </div><!-- /.crt-specs -->
                    </div><!-- /.crt-card -->

                    <!-- QR code section -->
                    <!-- <t t-if="card.record_url">
                        <div class="crt-qr-section">
                            <div class="crt-qr-title">QR Code &#160;·&#160; امسح للمشاركة</div>
                            <img
                                class="crt-qr-img"
                                t-attf-src="/report/barcode/?barcode_type=QR&amp;value={{ card.record_url }}&amp;width=300&amp;height=300"
                                alt="QR Code"/>
                            <t t-if="card.barcode">
                                <div class="crt-barcode-str">
                                    <t t-esc="card.barcode"/>
                                </div>
                            </t>
                        </div>
                    </t> -->

                    <!-- Open in backend -->
                    <a t-attf-href="{{ backend_url }}" class="crt-btn">
                        ⚙&#xFE0E;&#160; فتح في النظام
                    </a>

                    <!-- Footer -->
                    <div class="crt-footer">
                        Al-Omar Group &#160;·&#160; العمر جروب
                    </div>

                </div><!-- /.crt-page -->
            </body>
        </html>
    </template>
</odoo>
