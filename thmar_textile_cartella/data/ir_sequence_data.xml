<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_cartella_card" model="ir.sequence">
            <field name="name">Cartella Card Sequence</field>
            <field name="code">cartella.card.sequence</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="paperformat_label_70x100" model="report.paperformat">
    <field name="name">Cartella Label 70x100</field>
    <field name="default" eval="True"/>
    <field name="format">custom</field>
    <field name="page_width">70</field>
    <field name="page_height">100</field>
    <field name="margin_top">0</field>
    <field name="margin_bottom">0</field>
    <field name="margin_left">0</field>
    <field name="margin_right">0</field>
    <field name="header_spacing">0</field>
    <field name="dpi">96</field>
    <field name="disable_shrinking" eval="True"/>
    <field name="orientation">Portrait</field>
</record>
    </data>
</odoo>
