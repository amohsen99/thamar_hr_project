<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_cartella_label">
        <t t-call="web.html_container">
            <style type="text/css">
                @page {
                    margin: 0mm !important;
                    size: 70mm 100mm !important;
                }
                html, body {
                    margin: 0 !important;
                    padding: 0 !important;
                }
                .label-page {
                    width: 70mm;
                    height: 100mm;
                    box-sizing: border-box;
                    padding: 3mm;
                    border: 2px solid #000;
                    display: flex;
                    flex-direction: column;
                    font-family: Arial, sans-serif;
                    font-size: 9.5pt;
                    color: #000;
                    background: #fff;
                }
                .label-header {
                    text-align: center;
                    border-bottom: 1.5px solid #000;
                    padding-bottom: 2mm;
                    margin-bottom: 2mm;
                    flex-shrink: 0;
                }
                .label-header .brand {
                    font-size: 14pt;
                    font-weight: bold;
                    letter-spacing: 1px;
                }
                .label-header .seq {
                    font-size: 9pt;
                    font-weight: bold;
                    margin-top: 0.5mm;
                }
                .label-table {
                    width: 100%;
                    border-collapse: collapse;
                    font-size: 9pt;
                    font-weight: bold;
                    flex: 1 1 auto;
                    border: 1.5px solid #000;
                }
                .label-table td {
                    padding: 1.5mm 2mm;
                    border: 1px solid #000;
                    word-wrap: break-word;
                    overflow: hidden;
                }
                .label-table .lbl {
                    width: 35%;
                    background: #e8eeff;
                    font-size: 8.5pt;
                    white-space: nowrap;
                }
                .label-table .val {
                    text-align: center;
                    font-size: 9pt;
                }
                .label-table tr:nth-child(even) .lbl,
                .label-table tr:nth-child(even) .val {
                    background: #ffffff;
                }
                .label-footer {
                    flex-shrink: 0;
                    text-align: center;
                    border-top: 1.5px solid #000;
                    padding-top: 1.5mm;
                    margin-top: 2mm;
                }
                .label-footer img {
                    width: 18mm;
                    height: 18mm;
                    display: block;
                    margin: 0 auto 0.5mm auto;
                }
                .label-barcode {
                    font-family: 'Courier New', monospace;
                    font-size: 7.5pt;
                    font-weight: bold;
                    letter-spacing: 0.5px;
                    background: #f0f0f0;
                    border: 1px solid #000;
                    padding: 0.5mm 1.5mm;
                    display: inline-block;
                }
            </style>

            <t t-foreach="docs" t-as="doc">
                <div class="label-page">

                    <div class="label-header">
                        <div class="brand">CARTELLA</div>
                        <div class="seq"><t t-esc="doc.sequence_number or ''"/></div>
                    </div>

                    <table class="label-table">
                        <tr>
                            <td class="lbl">Product</td>
                            <td class="val">
                                <t t-esc="doc.finished_product_id.name or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td class="lbl">Code</td>
                            <td class="val">
                                <t t-esc="doc.reference or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td class="lbl">Width</td>
                            <td class="val">
                                <t t-esc="doc.finished_width or ''"/> 
                            </td>
                        </tr>
                        <tr>
                            <td class="lbl">Weight</td>
                            <td class="val">
                                <t t-esc="doc.finished_weight or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td class="lbl">Composition</td>
                            <td class="val">
                                <t t-if="doc.blend_ratio_id">
                                    <t t-esc="doc.blend_ratio_id or ''"/>
                                </t>
                                <t t-else="">
                                    <t t-esc="doc.barcode or ''"/>
                                </t>
                            </td>
                        </tr>
                    </table>

                    <div class="label-footer">
                        <t t-if="doc.qr_image">
                            <img t-att-src="image_data_uri(doc.qr_image)" alt="QR"/>
                        </t>
                        <t t-if="doc.barcode">
                            <div class="label-barcode">
                                <t t-esc="doc.barcode"/>
                            </div>
                        </t>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>
