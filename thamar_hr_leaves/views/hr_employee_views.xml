<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Employee Form: Leave Entitlement Section               -->
    <!-- Adds input fields and computed readonly breakdown      -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <record id="view_employee_form_inherit_leave_entitlement" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.leave.entitlement</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">

            <!-- Add a new page for Leave Entitlement details -->
            <xpath expr="//page[@name='hr_settings']" position="before">
                <page string="Leave Entitlement" name="leave_entitlement">

                    <!-- ── Input Fields ── -->
                    <group string="Leave Configuration" name="leave_config">
                        <group>
                            <field name="external_experience_years"
                                   widget="float"
                                   help="Previous insured service years that count towards the 10-year experience bonus."/>
                        </group>
                        <group>
                            <field name="is_hazardous_location"
                                   widget="boolean_toggle"
                                   help="Enable for +7 additional annual leave days."/>
                        </group>
                    </group>

                    <separator string="Computed Entitlement Details (Current Year)"/>

                    <!-- ── Computed Breakdown (Readonly) ── -->
                    <group string="Employee Details" name="leave_employee_details">
                        <group>
                            <field name="leave_employee_age" readonly="1"/>
                            <field name="leave_current_service_years" readonly="1" widget="float" digits="[10,1]"/>
                        </group>
                        <group>
                            <field name="leave_total_service_years" readonly="1" widget="float" digits="[10,1]"/>
                        </group>
                    </group>

                    <group string="Annual Leave Breakdown" name="leave_annual_breakdown">
                        <group>
                            <field name="leave_base_annual_days" readonly="1"/>
                            <field name="leave_age_bonus" readonly="1"/>
                            <field name="leave_experience_bonus" readonly="1"/>
                        </group>
                        <group>
                            <field name="leave_hazardous_bonus" readonly="1"/>
                            <field name="leave_total_annual_entitlement" readonly="1"
                                   class="fw-bold text-primary"/>
                        </group>
                    </group>

                    <group string="Casual Leave" name="leave_casual_breakdown">
                        <group>
                            <field name="leave_casual_entitlement" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Monthly Accrual Status (Annual Leave)"/>

                    <group string="Accrual Details" name="leave_accrual_status">
                        <group>
                            <field name="leave_annual_monthly_rate" readonly="1"
                                   widget="float" digits="[10,2]"/>
                            <field name="leave_annual_months_accrued" readonly="1"/>
                        </group>
                        <group>
                            <field name="leave_annual_accrual_cap" readonly="1"
                                   widget="float" digits="[10,2]"/>
                            <field name="leave_annual_accrued_remaining" readonly="1"
                                   widget="float" digits="[10,2]"
                                   class="fw-bold text-success"/>
                        </group>
                    </group>

                    <!-- ── Regenerate Button ── -->
                    <div class="mt-3">
                        <button name="action_regenerate_leave_allocations"
                                type="object"
                                string="🔄 Regenerate Leave Allocations"
                                class="btn-secondary"
                                groups="hr_holidays.group_hr_holidays_user"
                                confirm="This will regenerate leave allocations for the current year. Existing auto-generated allocations for this year will not be duplicated. Continue?"/>
                    </div>

                </page>
            </xpath>

        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Server Action: Regenerate Leave Allocations            -->
    <!-- Runs for selected employees from the list view         -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <record id="action_regenerate_all_leave_allocations" model="ir.actions.server">
        <field name="name">Regenerate Leave Allocations (Selected)</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">
for employee in records:
    env['hr.leave.allocation']._generate_employee_allocations(employee)
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Employee List View: Regenerate Button (selected rows) -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <record id="view_employee_tree_inherit_leave" model="ir.ui.view">
        <field name="name">hr.employee.tree.inherit.leave</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(thamar_hr_leaves.action_regenerate_all_leave_allocations)d"
                            string="🔄 Regenerate Leave Allocations"
                            type="action"
                            class="btn-secondary"
                            groups="hr_holidays.group_hr_holidays_user"
                            confirm="This will regenerate leave allocations for the selected employees. Continue?"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Menu Item: Employees in Time Off                       -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <menuitem
        id="menu_hr_holidays_employees"
        name="Employees"
        parent="hr_holidays.menu_hr_holidays_root"
        action="hr.open_view_employee_list_my"
        sequence="4"
        groups="hr_holidays.group_hr_holidays_user"/>

</odoo>
